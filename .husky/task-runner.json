{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "csharpier-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": ["csharpier", "format", "${staged}"],
         "include": ["**/*.cs"]
      },
      {
         "name": "dotnet-format-whitespace",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "format",
            "whitespace",
            "SimpleMessenger.sln",
            "--verify-no-changes",
            "--include",
            "${staged}"
         ],
         "include": ["**/*.cs"]
      }
   ]
}
