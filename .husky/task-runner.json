{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "csharpier-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "csharpier",
            "format",
            "${staged}"
         ],
         "include": [
            "**/*.cs"
         ]
      },
      {
         "name": "dotnet-format-check",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "format",
            "SimpleMessenger.sln",
            "--verify-no-changes",
            "--report"
         ]
      }
   ]
}