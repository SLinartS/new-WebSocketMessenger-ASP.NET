{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format-check",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [
            "format",
            "SimpleMessenger.sln",
            "--verify-no-changes",
            "--report",
            "--severity",
            "warn"
         ]
      }
   ]
}